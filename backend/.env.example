# Backend Ferretería — variables de entorno (ejemplo, copiar a .env)

# Base de datos MySQL/MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ferreteria
DB_PASSWORD=changeme
DB_NAME=ferreteria_db

# Servidor HTTP
SERVER_PORT=8080
GIN_MODE=release

# ============================================================================
# PAGOS — Stripe (Fase 1A del plan 2026-06-22)
# ============================================================================
# Claves de Stripe (https://dashboard.stripe.com/test/apikeys en modo sandbox).
# sk_test_* / pk_test_* para sandbox; sk_live_* / pk_live_* para producción.
# La SECRET KEY vive solo en el backend; la PUBLISHABLE KEY se devuelve al frontend.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret (sale de `stripe listen --forward-to ...` en desarrollo,
# o del dashboard en producción).
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Proveedor activo. Valores: stripe (único soportado en Fase 1A).
# Cambiar cuando se sume conekta/mercadopago sin tocar código.
PAGOS_PROVEEDOR_PRINCIPAL=stripe

# Cuando agreguemos Conekta (Fase 1B, opcional):
# CONEKTA_PUBLIC_KEY=
# CONEKTA_PRIVATE_KEY=
